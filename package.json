{
  "name": "instapoke",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @instapoke/server dev\" \"pnpm --filter @instapoke/client dev\"",
    "build": "pnpm --filter @instapoke/shared build && pnpm --filter @instapoke/server build && pnpm --filter @instapoke/client build",
    "seed": "pnpm --filter @instapoke/server seed",
    "test": "pnpm --filter @instapoke/server test && pnpm --filter @instapoke/client test",
    "generate:api": "tsx scripts/generate-api-types.ts",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.1",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.6.0"
}
